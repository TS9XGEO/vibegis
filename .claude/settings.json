{
  "permissions": {
    "allow": [
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose restart:*)",
      "Bash(docker compose up -d:*)",
      "Bash(docker compose build:*)",
      "Bash(docker compose exec frontend npm run typecheck:*)",
      "Bash(docker compose exec frontend npm run build:*)",
      "Bash(docker compose exec postgis psql:*)",
      "Bash(docker volume ls:*)",
      "Bash(curl -s http://localhost:8080/:*)",
      "Bash(curl -s -o /dev/null:*)",
      "Bash(curl -sI http://localhost:8080/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ogrinfo:*)",
      "Bash(gdalinfo:*)"
    ],
    "ask": [
      "Bash(docker compose down:*)",
      "Bash(docker volume rm:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Read(./.env)"
    ]
  }
}
