# ---- Database -------------------------------------------------------------
POSTGRES_DB=gis
POSTGRES_USER=gis
POSTGRES_PASSWORD=change_me_please
POSTGRES_PORT=5432

# ---- Host ports -----------------------------------------------------------
GATEWAY_PORT=8080          # nginx: frontend + all OGC endpoints
DAGSTER_PORT=3000          # Dagster web UI
PGADMIN_PORT=5050          # only with --profile tools

# ---- Auth ------------------------------------------------------------------
# Signs the login session JWT. Accounts live in Postgres (see bin/add-user.sh),
# not here. Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=change_me_please_use_a_long_random_string
# Marks the session cookie Secure (never sent over plain HTTP). Leave it on.
# http://localhost is exempt from the Secure rule in every current browser, so
# local development works unchanged; set it to false only for a plain-HTTP dev
# stack reached by IP or hostname.
COOKIE_SECURE=true

# ---- AI agent ---------------------------------------------------------------
# Encrypts each user's own Anthropic/OpenAI API key at rest (see upload-api/
# ai_agent.py) — deliberately separate from AUTH_JWT_SECRET, so rotating one
# doesn't force-invalidate the other. Generate with: openssl rand -hex 32
AI_KEY_ENCRYPTION_SECRET=change_me_please_use_a_long_random_string
# Password for the unprivileged "ai_readonly" Postgres role the agent's
# read-only DB tools connect as (created automatically on upload-api
# startup — see ensure_ai_schema()). Generate with: openssl rand -hex 32
AI_READONLY_PG_PASSWORD=change_me_please_use_a_long_random_string
# Password for the read-only "vibegis_render" Postgres role that mapserver,
# qgis-server, qgis-processing and pg_featureserv connect as — none of them
# writes, and none of them can reach configdb or userdb. Created by
# postgis/initdb/07-roles.sql on a fresh volume, bin/migrate-roles.sql on an
# existing one. Generate with: openssl rand -hex 32
RENDER_PG_PASSWORD=change_me_please_use_a_long_random_string

# ---- Container user ------------------------------------------------------
# The uid:gid the non-root containers (upload-api, qgis-processing, dagster,
# mapproxy, docker-stats-exporter) run as. It has to own this repo's bind
# mounts — mapserver/mapfiles, mapserver/rasters, pointclouds, mapproxy — or
# those services cannot write. 1001 is the development host's user; set it to
# your own `id -u`/`id -g`, then run bin/fix-ownership.sh once.
APP_UID=1001
APP_GID=1001

# ---- Image tags -----------------------------------------------------------
# Verify these once with: docker compose pull
POSTGIS_IMAGE=postgis/postgis:17-3.5
MAPSERVER_IMAGE=camptocamp/mapserver:8.0
QGISSERVER_IMAGE=camptocamp/qgis-server:3.40
NGINX_IMAGE=nginx:1.27-alpine
# Pinned, all of them. `:latest` here was not a convenience — GDAL_IMAGE is the
# base for BOTH upload-api and dagster, and ubuntu-small-latest tracks a
# nightly: the running stack was built on a GDAL 3.14.0dev snapshot, so any two
# rebuilds could differ. Images with no published version tags are pinned by
# digest instead; re-pin deliberately, never by dropping back to :latest.
GDAL_IMAGE=ghcr.io/osgeo/gdal:ubuntu-small-3.13.0
CTB_IMAGE=tumgis/ctb-quantized-mesh@sha256:31053c0cee60fe2f6651812786b2861e1dda03b25a88f2fa6325a4a9e266ad98
PGADMIN_IMAGE=dpage/pgadmin4:9.8
FEATURESERV_IMAGE=pramsey/pg_featureserv@sha256:2f1cf3adbf159b440098b7b4d5c75d9679baae5c79aed7560a84a15aecddf886
PG2B3DM_IMAGE=geodan/pg2b3dm@sha256:318d19d0612603d272eb9b719c747aa6786e02b1a400190aa12715f0486a559f      # only with --profile tiles3d
GRAFANA_PORT=3001           # log + metrics viewer UI, 127.0.0.1-only (see docker-compose.yml)
PROMETHEUS_PORT=9090        # Prometheus UI/API, 127.0.0.1-only, for debugging queries directly
LOKI_IMAGE=grafana/loki:3.2.1
PROMTAIL_IMAGE=grafana/promtail:3.2.1
GRAFANA_IMAGE=grafana/grafana:11.3.1
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1
GRAFANA_ADMIN_USER=admin
# Required — docker compose refuses to start without it rather than
# falling back to admin/admin. Generate with: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=change_me_please_use_a_long_random_string

# ---- pgAdmin (profile: tools) --------------------------------------------
PGADMIN_DEFAULT_EMAIL=thomas@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_too
