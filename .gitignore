# Secrets
.env

# Per-machine Claude Code settings; .claude/settings.json is the shared one
.claude/settings.local.json

# Large binaries — the DEM (~500MB) and everything baked from it
terrain/dem/*.tif
terrain/dem/_prepared.tif
terrain/tiles/

# Drop-zone for the ETL: source data, not source code
mapserver/data/*
!mapserver/data/.gitkeep

# Rasters published via POST /upload-raster — uploaded content, not source
mapserver/rasters/*
!mapserver/rasters/.gitkeep

# Generated by `docker compose --profile tiles3d run --rm pg2b3dm`
frontend-app/public/3dtiles/

# Node
node_modules/
frontend-app/dist/
npm-debug.log*

# Python
__pycache__/
*.pyc
